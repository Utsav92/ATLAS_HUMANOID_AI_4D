<mujoco model="atlas_g1_task_scene">
  <include file="g1_with_hands.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.2 0.2 0.2" specular="0.8 0.8 0.8"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table_mat" rgba="0.6 0.4 0.25 1" reflectance="0.1"/>
    <material name="shelf_mat" rgba="0.3 0.35 0.45 1" reflectance="0.2"/>
    <material name="red_cube_mat" rgba="0.9 0.15 0.15 1" reflectance="0.3"/>
  </asset>

  <worldbody>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    
    <!-- Table -->
    <body name="table" pos="0.85 0.0 0.25">
      <geom name="table_top" type="box" size="0.25 0.4 0.02" pos="0 0 0.23" material="table_mat"/>
      <geom name="table_leg1" type="cylinder" size="0.02 0.23" pos="0.2 0.35 0" material="table_mat"/>
      <geom name="table_leg2" type="cylinder" size="0.02 0.23" pos="-0.2 0.35 0" material="table_mat"/>
      <geom name="table_leg3" type="cylinder" size="0.02 0.23" pos="0.2 -0.35 0" material="table_mat"/>
      <geom name="table_leg4" type="cylinder" size="0.02 0.23" pos="-0.2 -0.35 0" material="table_mat"/>
    </body>

    <!-- Target Red Cube on Table -->
    <body name="red_cube" pos="0.75 0.05 0.53">
      <freejoint name="red_cube_joint"/>
      <geom name="red_cube_geom" type="box" size="0.025 0.025 0.025" material="red_cube_mat" mass="0.08"
            friction="1.5 0.01 0.005" solref="0.01 1" solimp="0.9 0.95 0.001"/>
    </body>

    <!-- Target Destination Shelf -->
    <body name="shelf" pos="0.85 0.45 0.35">
      <geom name="shelf_base" type="box" size="0.2 0.2 0.02" pos="0 0 0.2" material="shelf_mat"/>
      <geom name="shelf_back" type="box" size="0.02 0.2 0.15" pos="0.18 0 0.35" material="shelf_mat"/>
      <geom name="shelf_pillar1" type="cylinder" size="0.02 0.2" pos="0.15 0.15 0" material="shelf_mat"/>
      <geom name="shelf_pillar2" type="cylinder" size="0.02 0.2" pos="-0.15 0.15 0" material="shelf_mat"/>
      <geom name="shelf_pillar3" type="cylinder" size="0.02 0.2" pos="0.15 -0.15 0" material="shelf_mat"/>
      <geom name="shelf_pillar4" type="cylinder" size="0.02 0.2" pos="-0.15 -0.15 0" material="shelf_mat"/>
    </body>

    <!-- Tracking cameras -->
    <camera name="overhead_cam" pos="0.5 0.0 2.2" euler="0 0 0"/>
    <camera name="third_person_cam" pos="2.0 -1.5 1.4" euler="60 40 10"/>
  </worldbody>
</mujoco>
